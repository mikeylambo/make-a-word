{
  "name": "make-a-word",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "dictionary:build": "node scripts/derive-inflections.mjs --write",
    "dictionary:server": "node scripts/build-server-dictionary.mjs",
    "dictionary:server:check": "node scripts/build-server-dictionary.mjs --check",
    "analyze": "node scripts/analyze-phrases.mjs",
    "phrases:bank": "node scripts/build-phrase-bank.mjs",
    "phrases:review": "node scripts/review-phrase-bank.mjs",
    "daily:build": "node scripts/build-daily-schedule.mjs --write",
    "burn:derive": "node scripts/derive-burn.mjs",
    "burn:benchmark": "node scripts/benchmark-burn.mjs",
    "trials:simulate": "node scripts/simulate-round.mjs",
    "scoring:verify": "node scripts/verify-scoring.mjs",
    "rules:runtime": "node scripts/verify-word-rules-runtime.mjs",
    "themes:verify": "node scripts/verify-themes.mjs",
    "board:verify": "node scripts/verify-board.mjs",
    "mobile:verify": "node scripts/verify-mobile.mjs && node scripts/verify-mobile-runtime.mjs",
    "menu:verify": "node scripts/verify-menu.mjs",
    "flow:verify": "node scripts/verify-game-flow.mjs",
    "shell:verify": "node scripts/verify-shell-integrity.mjs",
    "save:runtime": "node scripts/verify-save-runtime.mjs",
    "telemetry:verify": "node scripts/verify-telemetry.mjs",
    "online:verify": "node scripts/verify-online-hardening.mjs",
    "doctor": "node scripts/phrase-doctor.mjs",
    "metrics": "node scripts/metrics.mjs",
    "verify": "npm run dictionary:server:check && npm run analyze && npm run phrases:review && npm run doctor && npm run burn:benchmark && npm run scoring:verify && npm run rules:runtime && npm run themes:verify && npm run board:verify && npm run mobile:verify && npm run menu:verify && npm run flow:verify && npm run shell:verify && npm run save:runtime && npm run telemetry:verify && npm run online:verify && npm run build"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "an-array-of-english-words": "^2.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
